{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "settings_version": {
      "const": 1,
      "default": 1
    },
    "ghosts": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "uploads": {
      "type": "object",
      "properties": {
        "zwift": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        },
        "strava": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "default": "paid",
              "enum": ["paid", "free"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "devices": {
      "type": "object",
      "properties": {
        "zwift_click": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workouts": {
      "type": "object",
      "properties": {
        "trainingpeaks": {
          "type": "object",
          "properties": {
            "bridge_folder": {
              "type": "string",
              "default": ""
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": ["settings_version"]
}

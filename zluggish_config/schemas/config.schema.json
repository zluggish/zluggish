{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "config_version": {
      "const": 1,
      "default": 1
    },
    "server": {
      "type": "object",
      "properties": {
        "advertised_ip": {
          "type": "string",
          "default": "127.0.0.1"
        }
      },
      "additionalProperties": false
    },
    "accounts": {
      "type": "object",
      "properties": {
        "allow_self_registration": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "bots": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "multiplier": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 100
        },
        "riders_file": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "proxy": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "enabled", "disabled"]
        }
      },
      "additionalProperties": false
    },
    "dns": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "leaderboards": {
      "type": "object",
      "properties": {
        "all_time": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "equipment": {
      "type": "object",
      "properties": {
        "unlock_entitlements": {
          "type": "boolean",
          "default": false
        },
        "unlock_all": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "ghosts": {
      "type": "object",
      "properties": {
        "profile_file": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "integrations": {
      "type": "object",
      "properties": {
        "garmin": {
          "type": "object",
          "properties": {
            "domain": {
              "type": "string",
              "default": "garmin.com"
            }
          },
          "additionalProperties": false
        },
        "discord": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "credentials_file": {
              "type": "string",
              "default": ""
            },
            "channel": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            },
            "welcome_message": {
              "type": "string",
              "default": ""
            },
            "help_message": {
              "type": "string",
              "default": ""
            },
            "announce_players": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "default": "INFO",
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "WARN",
            "ERROR",
            "CRITICAL",
            "NOTSET"
          ]
        }
      },
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "default": ""
        },
        "cdn": {
          "type": "object",
          "properties": {
            "host": {
              "type": ["string", "null"],
              "default": null
            },
            "port": {
              "type": "integer",
              "default": 80,
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        },
        "tcp": {
          "type": "object",
          "properties": {
            "host": {
              "type": ["string", "null"],
              "default": null
            },
            "port": {
              "type": "integer",
              "default": 3025,
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        },
        "udp": {
          "type": "object",
          "properties": {
            "host": {
              "type": ["string", "null"],
              "default": null
            },
            "port": {
              "type": "integer",
              "default": 3024,
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        },
        "api": {
          "type": "object",
          "properties": {
            "host": {
              "type": ["string", "null"],
              "default": null
            },
            "port": {
              "type": "integer",
              "default": 443,
              "minimum": 1,
              "maximum": 65535
            },
            "use_cert": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "user_defaults": {
      "type": "object",
      "properties": {
        "ghosts": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        },
        "uploads": {
          "type": "object",
          "properties": {
            "zwift": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                }
              },
              "additionalProperties": false
            },
            "strava": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "default": "paid",
                  "enum": ["paid", "free"]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "devices": {
          "type": "object",
          "properties": {
            "zwift_click": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "workouts": {
          "type": "object",
          "properties": {
            "trainingpeaks": {
              "type": "object",
              "properties": {
                "bridge_folder": {
                  "type": "string",
                  "default": ""
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": ["config_version"]
}

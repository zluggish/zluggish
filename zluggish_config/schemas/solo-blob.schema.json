{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "riders": {
      "type": "integer",
      "default": 8,
      "minimum": 0,
      "maximum": 30
    },
    "row_gap": {
      "type": "number",
      "default": 1.8,
      "exclusiveMinimum": 0
    },
    "tail_gap": {
      "type": "number",
      "default": 4.0
    },
    "lateral_spacing": {
      "type": "number",
      "default": 0.95,
      "exclusiveMinimum": 0
    },
    "lead_gap": {
      "type": "number",
      "default": 1.6
    },
    "lead_lateral": {
      "type": "number",
      "default": 0.8
    },
    "columns": {
      "type": "integer",
      "default": 0,
      "minimum": 0
    },
    "shuffle_interval": {
      "type": "number",
      "default": 25
    },
    "rotate": {
      "type": "boolean",
      "default": true
    },
    "pull_interval": {
      "type": "number",
      "default": 60
    },
    "lead_spread": {
      "type": "number",
      "default": 1
    },
    "full_range": {
      "type": "boolean",
      "default": false
    },
    "max_lead": {
      "type": "number",
      "default": 8
    },
    "diag_interval": {
      "type": "number",
      "default": 0,
      "minimum": 0
    },
    "latency_comp": {
      "type": ["number", "string"],
      "default": 0
    },
    "formation_interval": {
      "type": "number",
      "default": 45
    },
    "turn_interval": {
      "type": "number",
      "default": 1200
    },
    "rotation_rate": {
      "type": "number",
      "default": 0.7,
      "exclusiveMinimum": 0
    },
    "pull_duration": {
      "type": "number",
      "default": 18
    },
    "pass_time": {
      "type": "number",
      "default": 18,
      "exclusiveMinimum": 0
    },
    "climb_stretch": {
      "type": "number",
      "default": 1.0
    },
    "max_drop": {
      "type": "number",
      "default": 30
    },
    "hammer_time": {
      "type": "number",
      "default": 180
    },
    "toast_time": {
      "type": "number",
      "default": 120
    },
    "lead_time": {
      "type": "number",
      "default": 120
    },
    "wander_gap": {
      "type": "number",
      "default": 0.3
    },
    "wander_lateral": {
      "type": "number",
      "default": 0.15
    },
    "bot_gestures": {
      "type": "boolean",
      "default": true
    },
    "gesture_interval": {
      "type": "number",
      "default": 75
    },
    "gesture_chance": {
      "type": "number",
      "default": 1.0
    },
    "wander_time": {
      "type": "number",
      "default": 7
    },
    "ragged_rows": {
      "type": "boolean",
      "default": false
    },
    "lateral_via": {
      "type": "string",
      "default": "both"
    },
    "lateral_scale": {
      "type": "number",
      "default": 1.0
    },
    "road_half_width": {
      "type": "number",
      "default": 3.0
    },
    "road_limits": {
      "type": "string",
      "default": "auto"
    },
    "max_road_shift": {
      "type": "number",
      "default": 4.0
    },
    "road_axis_limit": {
      "type": "number",
      "default": 1.5
    },
    "road_axis_side": {
      "type": "number",
      "default": -1
    },
    "only_kitted": {
      "type": "boolean",
      "default": true
    },
    "scatter": {
      "type": "boolean",
      "default": true
    },
    "scatter_width": {
      "type": "number",
      "default": 3.0
    },
    "scatter_gap": {
      "type": "number",
      "default": 1.75
    },
    "scatter_side": {
      "type": "number",
      "default": 1.0
    },
    "scatter_beside": {
      "type": "number",
      "default": 1.0
    },
    "keep_apart_long": {
      "type": "number",
      "default": 1.75
    },
    "keep_apart": {
      "type": "number",
      "default": 0.85
    },
    "player_id": {
      "type": "integer",
      "default": 1,
      "minimum": 1
    },
    "record": {
      "type": "boolean",
      "default": false
    }
  },
  "additionalProperties": false
}

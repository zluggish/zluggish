{
  "name": "zluggish",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13 <27"
  },
  "packageManager": "pnpm@12.18.0",
  "exports": {
    "./config": {
      "types": "./dist/src/config/index.d.ts",
      "default": "./dist/src/config/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm build:web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit && pnpm test:medium",
    "dev": "node --watch --conditions=development --import tsx --import ./scripts/register-svelte.mjs src/main.ts",
    "start": "node dist/src/main.js",
    "format": "prettier --config .prettierrc --ignore-path ../.prettierignore --check ..",
    "format:fix": "prettier --config .prettierrc --ignore-path ../.prettierignore --write ..",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:fix": "cd .. && node server/node_modules/oxlint/bin/oxlint --config server/oxlint.config.ts --fix server/src server/tests web && node server/node_modules/eslint/bin/eslint.js --config server/eslint.config.mjs \"server/src/**/*.{ts,tsx}\" \"server/tests/**/*.ts\" \"web/**/*.{ts,svelte}\" --fix",
    "check": "pnpm i18n:check && pnpm lint && pnpm typecheck && pnpm test && pnpm format",
    "codegen": "buf generate && node scripts/normalize-generated.mjs",
    "test:unit": "node --conditions=development --import tsx --import ./scripts/register-svelte.mjs --test \"src/**/*.spec.ts\"",
    "test:medium": "pnpm build:web && node --conditions=development --import tsx --import ./scripts/register-svelte.mjs --test tests/medium/*.spec.ts",
    "test:load": "node --conditions=development --import tsx tests/load/persistence.ts",
    "lint:eslint": "cd .. && node server/node_modules/eslint/bin/eslint.js --config server/eslint.config.mjs \"server/src/**/*.{ts,tsx}\" \"server/tests/**/*.ts\" \"web/**/*.{ts,svelte}\" --max-warnings 0",
    "cli": "node --conditions=development --import tsx src/cli/bin.ts",
    "build:web": "pnpm --dir ../web build",
    "dev:web": "pnpm --dir ../web exec vite build --mode game --watch",
    "check:web": "pnpm --dir ../web check",
    "test:browser": "pnpm build && node --test dist/tests/browser/*.spec.js",
    "screenshots": "pnpm build:web && node --conditions=development --import tsx --import ./scripts/register-svelte.mjs scripts/screenshots.ts",
    "lint:oxlint": "cd .. && node server/node_modules/oxlint/bin/oxlint --config server/oxlint.config.ts server/src server/tests web",
    "i18n:check": "pnpm --dir .. i18n:check"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.0.0",
    "@garmin/fitsdk": "^21.221.0",
    "@hono/node-server": "2.1.8",
    "@types/node": "^26.6.0",
    "@zluggish/i18n": "workspace:*",
    "@zluggish/web": "workspace:*",
    "argon2": "^0.45.2",
    "discord.js": "^14.28.1",
    "dns-packet": "^5.6.1",
    "effect": "4.1.4",
    "fast-xml-parser": "^5.12.0",
    "fs-ext-extra-prebuilt": "^2.2.17",
    "garminconnect-js": "^0.11.1",
    "hono": "^4.0.0",
    "ini": "^6.0.0",
    "jiti": "^2.0.0",
    "kysely": "^0.29.9",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@cloudflare/oxlint-config": "0.1.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/montserrat": "5.2.8",
    "@stylistic/eslint-plugin": "^6.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/dns-packet": "^5.6.5",
    "@types/ini": "^4.1.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-svelte": "3.24.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "oxlint": "^1.94.0",
    "playwright": "1.65.1",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.10.1",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "tsx": "^4.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.8"
  },
  "imports": {
    "#src/*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/src/*.js"
    },
    "#tests/*": {
      "types": "./tests/*.ts",
      "development": "./tests/*.ts",
      "default": "./dist/tests/*.js"
    },
    "#game": "@zluggish/web/render"
  },
  "bin": {
    "zluggish": "./dist/src/cli/bin.js"
  }
}

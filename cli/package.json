{
  "name": "zluggish-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "packageManager": "pnpm@10.28.1",
  "bin": {
    "zluggish": "./dist/src/bin.js"
  },
  "imports": {
    "#cli/*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "build": "pnpm --dir ../server build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=development --import tsx --test tests/*.test.ts",
    "cli": "node --conditions=development --import tsx src/bin.ts",
    "lint:anti-slop": "cd .. && node cli/node_modules/oxlint/bin/oxlint --config cli/.oxlintrc.json cli/src cli/tests server/src server/tests",
    "lint:eslint": "cd .. && node cli/node_modules/eslint/bin/eslint.js --config cli/eslint.config.mjs \"cli/src/**/*.ts\" \"cli/tests/**/*.ts\" \"server/src/**/*.{ts,tsx}\" \"server/tests/**/*.ts\" --max-warnings 0",
    "lint": "pnpm lint:anti-slop && pnpm lint:eslint",
    "format": "prettier --config .prettierrc --ignore-path ../.prettierignore --check ..",
    "format:fix": "prettier --config .prettierrc --ignore-path ../.prettierignore --write ..",
    "lint:fix": "cd .. && node cli/node_modules/oxlint/bin/oxlint --config cli/.oxlintrc.json --fix cli/src cli/tests server/src server/tests && node cli/node_modules/eslint/bin/eslint.js --config cli/eslint.config.mjs \"cli/src/**/*.ts\" \"cli/tests/**/*.ts\" \"server/src/**/*.{ts,tsx}\" \"server/tests/**/*.ts\" --fix"
  },
  "dependencies": {
    "zluggish": "link:../server",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oxlint/plugins": "1.93.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "oxlint": "1.93.0",
    "prettier": "3.6.2",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

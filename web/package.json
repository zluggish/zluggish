{
  "name": "@zluggish/web",
  "private": true,
  "type": "module",
  "exports": {
    "./types": "./src/lib/game-app.dto.d.ts",
    "./render": {
      "types": "./src/game/render.d.ts",
      "development": "./src/game/server.ts",
      "default": "./dist/game/server/entry.js"
    }
  },
  "scripts": {
    "build": "pnpm build:game && pnpm build:app",
    "build:game": "vite build --mode game && vite build --ssr --mode game",
    "build:app": "vite build --mode app",
    "check": "svelte-check --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@zluggish/i18n": "workspace:*",
    "svelte": "5.57.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/montserrat": "5.2.8",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte-check": "4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.8"
  }
}
